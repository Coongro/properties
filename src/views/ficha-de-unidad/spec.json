{
  "specVersion": 1,
  "kind": "blank",
  "title": "Ficha de unidad",
  "data": {
    "repositoryPrefix": "properties.units"
  },
  "blocks": [
    {
      "id": "hdr",
      "kind": "container",
      "ctype": "header",
      "alias": "Encabezado",
      "back": true,
      "name": "Belgrano 1240 · 3°B",
      "sub": "3 ambientes · 2 baños · 72 m²",
      "badge": {
        "text": "Vacante",
        "tone": "outline"
      },
      "actions": [
        {
          "label": "Editar unidad",
          "variant": "secondary",
          "action": {
            "id": "openForm",
            "label": "Editar unidad",
            "target": "properties.unidad.open"
          }
        }
      ],
      "children": []
    },
    {
      "id": "row_kpi",
      "kind": "container",
      "ctype": "columns",
      "alias": "Fila KPI",
      "cols": [
        {
          "fr": 0.34,
          "children": [
            {
              "id": "k_estado",
              "kind": "component",
              "comp": "SummaryCard",
              "props": {
                "label": "Estado",
                "value": "Vacante",
                "sub": "sin contrato vigente",
                "icon": "DoorOpen",
                "tone": "warning"
              }
            }
          ]
        },
        {
          "fr": 0.33,
          "children": [
            {
              "id": "k_renta",
              "kind": "component",
              "comp": "SummaryCard",
              "props": {
                "label": "Alquiler de referencia",
                "value": "$485.000",
                "sub": "valor de publicación",
                "icon": "Wallet",
                "tone": "neutral"
              }
            }
          ]
        },
        {
          "fr": 0.33,
          "children": [
            {
              "id": "k_titularidad",
              "kind": "component",
              "comp": "SummaryCard",
              "props": {
                "label": "Titularidad",
                "value": "Falta 50 %",
                "sub": "1 titular cargado",
                "icon": "Users",
                "tone": "warning"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "sec_titulares",
      "kind": "container",
      "ctype": "section",
      "label": "Titulares",
      "icon": "Users",
      "children": [
        {
          "id": "btn_titular",
          "kind": "component",
          "comp": "Button",
          "align": "right",
          "props": {
            "label": "Agregar titular",
            "variant": "secondary",
            "action": {
              "id": "openForm",
              "label": "Agregar titular",
              "target": "properties.propietario.open"
            }
          }
        },
        {
          "id": "tbl_titulares",
          "kind": "component",
          "comp": "DataTable",
          "props": {
            "pageSize": "20",
            "filters": [],
            "columns": [
              {
                "key": "name",
                "label": "Titular"
              },
              {
                "key": "document",
                "label": "Documento",
                "emptyLabel": "Sin documento"
              },
              {
                "key": "share_label",
                "label": "Participación"
              },
              {
                "key": "role",
                "label": "Carácter",
                "display": "pill",
                "values": [
                  {
                    "value": "titular",
                    "label": "Titular",
                    "tone": "neutral",
                    "icon": "UserCheck"
                  },
                  {
                    "value": "cotitular",
                    "label": "Cotitular",
                    "tone": "neutral",
                    "icon": "Users"
                  },
                  {
                    "value": "usufructuario",
                    "label": "Usufructuario",
                    "tone": "success",
                    "icon": "HandCoins"
                  },
                  {
                    "value": "nudo_propietario",
                    "label": "Nudo propietario",
                    "tone": "neutral",
                    "icon": "KeyRound"
                  }
                ]
              }
            ],
            "actions": [
              {
                "label": "Quitar",
                "variant": "destructive",
                "icon": "UserMinus",
                "confirm": "¿Sacar a esta persona de la titularidad de la unidad? La persona no se borra: queda sin esta unidad a su nombre, y se la puede volver a cargar.",
                "action": {
                  "id": "serverAction",
                  "label": "Quitar",
                  "target": "properties.unitOwners.removeOwner"
                }
              }
            ],
            "emptyTitle": "Esta unidad no tiene titulares cargados",
            "emptySub": "Sin dueño cargado no hay a quién liquidarle lo que se cobra."
          }
        }
      ]
    },
    {
      "id": "sec_certificados",
      "kind": "container",
      "ctype": "section",
      "label": "Certificados",
      "icon": "ShieldCheck",
      "children": [
        {
          "id": "btn_cert",
          "kind": "component",
          "comp": "Button",
          "align": "right",
          "props": {
            "label": "Registrar certificado",
            "variant": "secondary",
            "action": {
              "id": "openForm",
              "label": "Registrar certificado",
              "target": "properties.certificado.open"
            }
          }
        },
        {
          "id": "tbl_certificados",
          "kind": "component",
          "comp": "DataTable",
          "props": {
            "view": "list",
            "subtitle": "status",
            "pageSize": "10",
            "rowAction": {
              "id": "openForm",
              "label": "Editar certificado",
              "target": "properties.certificado.open"
            },
            "columns": [
              {
                "key": "type",
                "label": "Certificado",
                "display": "pill",
                "values": [
                  {
                    "value": "matafuegos",
                    "label": "Matafuegos",
                    "tone": "outline",
                    "icon": "FireExtinguisher"
                  },
                  {
                    "value": "gas",
                    "label": "Instalación de gas",
                    "tone": "outline",
                    "icon": "Flame"
                  },
                  {
                    "value": "ascensor",
                    "label": "Ascensor",
                    "tone": "outline",
                    "icon": "MoveVertical"
                  },
                  {
                    "value": "electricidad",
                    "label": "Instalación eléctrica",
                    "tone": "outline",
                    "icon": "Zap"
                  },
                  {
                    "value": "seguro",
                    "label": "Seguro del inmueble",
                    "tone": "outline",
                    "icon": "Umbrella"
                  },
                  {
                    "value": "otro",
                    "label": "Otro",
                    "tone": "outline",
                    "icon": "FileText"
                  }
                ]
              },
              {
                "key": "scope",
                "label": "Alcance",
                "display": "pill",
                "values": [
                  {
                    "value": "unidad",
                    "label": "De la unidad",
                    "tone": "neutral",
                    "icon": "DoorOpen"
                  },
                  {
                    "value": "edificio",
                    "label": "Del edificio",
                    "tone": "outline",
                    "icon": "Building2"
                  }
                ]
              },
              {
                "key": "status",
                "label": "Estado",
                "display": "pill",
                "values": [
                  {
                    "value": "vigente",
                    "label": "Vigente",
                    "tone": "success"
                  },
                  {
                    "value": "por_vencer",
                    "label": "Por vencer",
                    "tone": "warning"
                  },
                  {
                    "value": "vencido",
                    "label": "Vencido",
                    "tone": "danger"
                  }
                ]
              },
              {
                "key": "expires_at",
                "label": "Vence",
                "format": "date"
              }
            ],
            "cells": [
              [
                "gas",
                "unidad",
                "vigente",
                "2027-03-20"
              ],
              [
                "ascensor",
                "edificio",
                "por_vencer",
                "2026-09-05"
              ],
              [
                "matafuegos",
                "edificio",
                "vigente",
                "2026-12-01"
              ]
            ],
            "filters": [],
            "actions": [
              {
                "label": "Eliminar",
                "variant": "destructive",
                "icon": "Trash2",
                "confirm": "El certificado se elimina de esta unidad.",
                "action": {
                  "id": "serverAction",
                  "label": "Eliminar",
                  "target": "properties.certificates.delete"
                },
                "showWhenColumn": "scope",
                "showWhenValues": "unidad"
              }
            ],
            "emptyTitle": "Sin certificados que alcancen a esta unidad",
            "emptySub": "Se ven los suyos y los del edificio: cargá el primero para que te avise antes del vencimiento."
          }
        }
      ]
    }
  ],
  "headless": {
    "handlers": [
      {
        "hook": "loadLiveValues",
        "mode": "query",
        "action": "properties.unitOwners.ownershipOf"
      },
      {
        "hook": "loadDataFor",
        "key": "tbl_titulares",
        "mode": "query",
        "action": "properties.unitOwners.listByUnit",
        "resource": "properties.unitOwners",
        "outputBlockId": "tbl_titulares"
      },
      {
        "hook": "loadDataFor",
        "key": "tbl_certificados",
        "mode": "query",
        "action": "properties.certificates.listByUnit",
        "resource": "properties.certificates",
        "outputBlockId": "tbl_certificados"
      },
      {
        "hook": "onAction",
        "key": "properties.unitOwners.removeOwner",
        "mode": "command",
        "action": "properties.unitOwners.removeOwner",
        "effect": "destructive",
        "confirmation": "always"
      },
      {
        "hook": "onAction",
        "key": "properties.certificates.delete",
        "mode": "command",
        "action": "properties.certificates.delete",
        "resource": "properties.certificates",
        "effect": "destructive",
        "confirmation": "always"
      }
    ]
  }
}
