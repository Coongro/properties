{
  "specVersion": 1,
  "kind": "blank",
  "title": "Ficha de unidad",
  "data": {
    "repositoryPrefix": "properties.units"
  },
  "blocks": [
    {
      "id": "hdr",
      "kind": "container",
      "ctype": "header",
      "alias": "Encabezado",
      "back": true,
      "name": "Belgrano 1240 · 3°B",
      "sub": "3 ambientes · 2 baños · 72 m²",
      "badge": {
        "text": "Vacante",
        "tone": "outline"
      },
      "actions": [
        {
          "label": "Editar unidad",
          "variant": "secondary",
          "action": {
            "id": "openForm",
            "label": "Editar unidad",
            "target": "properties.unidad.open"
          }
        }
      ],
      "children": []
    },
    {
      "id": "row_kpi",
      "kind": "container",
      "ctype": "columns",
      "alias": "Fila KPI",
      "cols": [
        {
          "fr": 0.34,
          "children": [
            {
              "id": "k_estado",
              "kind": "component",
              "comp": "SummaryCard",
              "props": {
                "label": "Estado",
                "value": "Vacante",
                "sub": "sin contrato vigente",
                "icon": "DoorOpen",
                "tone": "warning"
              }
            }
          ]
        },
        {
          "fr": 0.33,
          "children": [
            {
              "id": "k_renta",
              "kind": "component",
              "comp": "SummaryCard",
              "props": {
                "label": "Alquiler de referencia",
                "value": "$485.000",
                "sub": "valor de publicación",
                "icon": "Wallet",
                "tone": "neutral"
              }
            }
          ]
        },
        {
          "fr": 0.33,
          "children": [
            {
              "id": "k_titularidad",
              "kind": "component",
              "comp": "SummaryCard",
              "props": {
                "label": "Titularidad",
                "value": "Falta 50 %",
                "sub": "1 titular cargado",
                "icon": "Users",
                "tone": "warning"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "sec_titulares",
      "kind": "container",
      "ctype": "section",
      "label": "Titulares",
      "icon": "Users",
      "children": [
        {
          "id": "btn_titular",
          "kind": "component",
          "comp": "Button",
          "align": "right",
          "props": {
            "label": "Agregar titular",
            "variant": "secondary",
            "action": {
              "id": "openForm",
              "label": "Agregar titular",
              "target": "properties.propietario.open"
            }
          }
        },
        {
          "id": "tbl_titulares",
          "kind": "component",
          "comp": "DataTable",
          "props": {
            "pageSize": "20",
            "filters": [],
            "columns": [
              {
                "key": "name",
                "label": "Titular"
              },
              {
                "key": "document",
                "label": "Documento",
                "emptyLabel": "Sin documento"
              },
              {
                "key": "share_label",
                "label": "Participación"
              },
              {
                "key": "role",
                "label": "Carácter",
                "display": "pill",
                "values": [
                  {
                    "value": "titular",
                    "label": "Titular",
                    "tone": "neutral",
                    "icon": "UserCheck"
                  },
                  {
                    "value": "cotitular",
                    "label": "Cotitular",
                    "tone": "neutral",
                    "icon": "Users"
                  },
                  {
                    "value": "usufructuario",
                    "label": "Usufructuario",
                    "tone": "success",
                    "icon": "HandCoins"
                  },
                  {
                    "value": "nudo_propietario",
                    "label": "Nudo propietario",
                    "tone": "neutral",
                    "icon": "KeyRound"
                  }
                ]
              }
            ],
            "actions": [
              {
                "label": "Quitar",
                "variant": "destructive",
                "icon": "UserMinus",
                "confirm": "¿Sacar a esta persona de la titularidad de la unidad? La persona no se borra: queda sin esta unidad a su nombre, y se la puede volver a cargar.",
                "successToast": "Titular quitado",
                "action": {
                  "id": "serverAction",
                  "label": "Quitar",
                  "target": "properties.unitOwners.removeOwner"
                }
              }
            ],
            "emptyTitle": "Esta unidad no tiene titulares cargados",
            "emptySub": "Sin dueño cargado no hay a quién liquidarle lo que se cobra."
          }
        }
      ]
    }
  ],
  "headless": {
    "handlers": [
      {
        "hook": "loadLiveValues",
        "mode": "query",
        "action": "properties.unitOwners.ownershipOf"
      },
      {
        "hook": "loadDataFor",
        "key": "tbl_titulares",
        "mode": "query",
        "action": "properties.unitOwners.listByUnit",
        "resource": "properties.unitOwners",
        "outputBlockId": "tbl_titulares"
      },
      {
        "hook": "onAction",
        "key": "properties.unitOwners.removeOwner",
        "mode": "command",
        "action": "properties.unitOwners.removeOwner",
        "effect": "destructive",
        "confirmation": "always"
      }
    ]
  }
}
