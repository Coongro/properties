{
  "specVersion": 1,
  "kind": "blank",
  "title": "Propietarios",
  "blocks": [
    {
      "id": "ph",
      "kind": "component",
      "comp": "PageHeader",
      "props": {
        "kicker": "ALQUILERES",
        "title": "Propietarios",
        "subtitle": "Los titulares de las unidades y sus datos de cobro.",
        "actionLabel": "Nuevo propietario",
        "action": {
          "id": "openForm",
          "label": "Nuevo propietario",
          "target": "properties.propietario.open"
        }
      }
    },
    {
      "id": "tbl",
      "kind": "component",
      "comp": "DataTable",
      "props": {
        "view": "list",
        "imageCol": "photo_url",
        "imageLayout": "avatar",
        "subtitle": "document",
        "pageSize": "20",
        "columns": [
          {
            "key": "name",
            "label": "Propietario"
          },
          {
            "key": "document",
            "label": "Documento",
            "display": "mono",
            "emptyLabel": "Sin documento"
          },
          {
            "key": "units",
            "label": "Unidades"
          },
          {
            "key": "cbu",
            "label": "CBU / alias",
            "display": "mono",
            "emptyLabel": "Sin datos de cobro"
          },
          {
            "key": "bank",
            "label": "Banco",
            "visible": false
          },
          {
            "key": "photo_url",
            "label": "Foto",
            "visible": false
          },
          {
            "key": "unit_count",
            "label": "Cantidad de unidades",
            "visible": false,
            "internal": true
          },
          {
            "key": "many_units",
            "label": "Tiene varias",
            "visible": false,
            "internal": true
          }
        ],
        "cells": [
          [
            "Axel Fernández",
            "CUIT 20-28994120-5",
            "4 unidades",
            "axel.alquileres",
            "Banco Nación",
            "",
            "4",
            "si"
          ],
          [
            "Ana María Ruiz",
            "CUIT 27-11402887-3",
            "2 unidades",
            "ana.ruiz.mp",
            "Banco Galicia",
            "",
            "2",
            "si"
          ]
        ],
        "filters": [],
        "actions": [
          {
            "label": "Editar",
            "icon": "Pencil",
            "action": {
              "id": "openForm",
              "label": "Editar",
              "target": "properties.propietario.open"
            }
          },
          {
            "label": "Eliminar",
            "variant": "destructive",
            "icon": "Trash2",
            "confirm": "La persona se da de baja de la cartera. Si tiene unidades a su nombre no se va a poder: primero hay que quitarle la titularidad.",
            "action": {
              "id": "serverAction",
              "label": "Eliminar",
              "target": "properties.unitOwners.deleteOwner"
            }
          }
        ],
        "emptyTitle": "Todavía no hay propietarios",
        "emptySub": "Cargá los titulares para poder repartir lo cobrado.",
        "rowAction": {
          "id": "navigate",
          "label": "Ver ficha",
          "target": "properties.ficha-de-propietario.open"
        }
      }
    }
  ],
  "headless": {
    "handlers": [
      {
        "hook": "loadData",
        "mode": "query",
        "action": "properties.unitOwners.listOwners",
        "resource": "properties.unitOwners"
      },
      {
        "hook": "onAction",
        "key": "properties.unitOwners.deleteOwner",
        "mode": "command",
        "action": "properties.unitOwners.deleteOwner",
        "resource": "properties.unitOwners",
        "effect": "destructive",
        "confirmation": "always"
      }
    ]
  }
