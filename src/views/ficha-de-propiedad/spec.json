  "headless": {
    "handlers": [
      {
        "hook": "loadLiveValues",
        "mode": "query",
        "action": "properties.buildings.getSummary",
        "resource": "properties.buildings"
      },
      {
        "hook": "loadDataFor",
        "key": "tbl_unidades",
        "mode": "query",
        "action": "properties.units.listByBuilding",
        "resource": "properties.units",
        "outputBlockId": "tbl_unidades"
      },
      {
        "hook": "loadDataFor",
        "key": "tbl_certs",
        "mode": "query",
        "action": "properties.certificates.listByBuilding",
        "resource": "properties.certificates",
        "outputBlockId": "tbl_certs"
      },
      {
        "hook": "loadDataFor",
        "key": "tbl_expensas",
        "mode": "query",
        "action": "properties.buildingExpenses.forBuilding",
        "resource": "properties.buildingExpenses",
        "outputBlockId": "tbl_expensas"
      },
      {
        "hook": "loadDataFor",
        "key": "tbl_ot",
        "mode": "uiOnly",
        "reason": "Las órdenes de trabajo llegan con el plugin maintenance (F5); hasta entonces la tabla muestra su estado vacío."
      },
      {
        "hook": "loadDataFor",
        "key": "tbl_titulares_prop",
        "mode": "query",
        "action": "properties.unitOwners.listByBuilding",
        "resource": "properties.unitOwners",
        "outputBlockId": "tbl_titulares_prop"
      },
      {
        "hook": "onAction",
        "key": "properties.unitOwners.removeOwner",
        "mode": "command",
        "action": "properties.unitOwners.removeOwner",
        "effect": "destructive",
        "confirmation": "always"
      },
      {
        "hook": "onAction",
        "key": "properties.units.delete",
        "mode": "command",
        "action": "properties.units.delete",
        "resource": "properties.units",
        "effect": "destructive",
        "confirmation": "always"
      },
      {
        "hook": "onAction",
        "key": "properties.certificates.delete",
        "mode": "command",
        "action": "properties.certificates.delete",
        "resource": "properties.certificates",
        "effect": "destructive",
        "confirmation": "always"
      },
      {
        "hook": "onAction",
        "key": "properties.buildingExpenses.delete",
        "mode": "command",
        "action": "properties.buildingExpenses.delete",
        "resource": "properties.buildingExpenses",
        "effect": "destructive",
        "confirmation": "always"
      }
    ]
  }
}
