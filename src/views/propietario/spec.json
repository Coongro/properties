{
  "specVersion": 1,
  "kind": "form",
  "title": "Propietario",
  "blocks": [
    {
      "id": "s1",
      "kind": "container",
      "ctype": "card",
      "label": "Quién es",
      "icon": "User",
      "children": [
        {
          "id": "f_name",
          "kind": "field",
          "name": "name",
          "fieldType": "text",
          "label": "Nombre y apellido o razón social",
          "width": "half",
          "validations": [
            "required"
          ],
          "placeholder": "Ej: Ana María Ruiz"
        },
        {
          "id": "f_doc_type",
          "kind": "field",
          "name": "document_type",
          "fieldType": "enum",
          "label": "Documento",
          "width": "half",
          "validations": [
            "required"
          ],
          "options": [
            {
              "value": "cuit",
              "label": "CUIT"
            },
            {
              "value": "cuil",
              "label": "CUIL"
            },
            {
              "value": "dni",
              "label": "DNI"
            }
          ]
        },
        {
          "id": "f_doc",
          "kind": "field",
          "name": "document_number",
          "fieldType": "text",
          "label": "Número",
          "width": "half",
          "validations": [
            "required"
          ],
          "placeholder": "Ej: 27-11402887-3"
        },
        {
          "id": "f_tax",
          "kind": "field",
          "name": "tax_condition",
          "fieldType": "enum",
          "label": "Condición frente al IVA",
          "width": "half",
          "validations": [],
          "options": [
            {
              "value": "monotributo",
              "label": "Monotributo"
            },
            {
              "value": "responsable_inscripto",
              "label": "Responsable inscripto"
            },
            {
              "value": "exento",
              "label": "Exento"
            },
            {
              "value": "consumidor_final",
              "label": "Consumidor final"
            }
          ]
        }
      ]
    },
    {
      "id": "s2",
      "kind": "container",
      "ctype": "card",
      "label": "Contacto",
      "icon": "Phone",
      "children": [
        {
          "id": "f_email",
          "kind": "field",
          "name": "email",
          "fieldType": "text",
          "label": "Email",
          "width": "half",
          "validations": [],
          "placeholder": "Ej: ana.ruiz@gmail.com"
        },
        {
          "id": "f_phone",
          "kind": "field",
          "name": "phone",
          "fieldType": "text",
          "label": "Teléfono",
          "width": "half",
          "validations": [],
          "placeholder": "Ej: 341 555-1234"
        },
        {
          "id": "f_address",
          "kind": "field",
          "name": "address",
          "fieldType": "text",
          "label": "Domicilio",
          "validations": [],
          "placeholder": "Ej: Pellegrini 1450, Rosario"
        }
      ]
    },
    {
      "id": "s4",
      "kind": "container",
      "ctype": "card",
      "label": "Qué unidad le pertenece",
      "icon": "DoorOpen",
      "children": [
        {
          "id": "f_unit",
          "kind": "field",
          "name": "unit_id",
          "fieldType": "ref",
          "label": "Unidad",
          "refEntity": "properties.units",
          "refDisplay": "label",
          "refSubtitle": "detail",
          "width": "half",
          "validations": [],
          "help": "Opcional: se puede cargar la persona ahora y decir de qué unidad es dueña después."
        },
        {
          "id": "f_share",
          "kind": "field",
          "name": "share_pct",
          "fieldType": "number",
          "label": "Participación (%)",
          "width": "half",
          "validations": [],
          "placeholder": "Ej: 50 · vacío = 100 %",
          "help": "Si es dueño único, dejalo vacío: se toma 100 %. Entre todos los dueños de una unidad no puede pasar de 100 %."
        },
        {
          "id": "f_role",
          "kind": "field",
          "name": "role",
          "fieldType": "enum",
          "label": "Carácter",
          "validations": [],
          "options": [
            {
              "value": "titular",
              "label": "Titular",
              "icon": "UserCheck"
            },
            {
              "value": "cotitular",
              "label": "Cotitular",
              "icon": "Users"
            },
            {
              "value": "usufructuario",
              "label": "Usufructuario",
              "icon": "HandCoins"
            },
            {
              "value": "nudo_propietario",
              "label": "Nudo propietario",
              "icon": "KeyRound"
            }
          ],
          "help": "El usufructuario percibe el alquiler; el nudo propietario conserva el dominio sin cobrarlo."
        }
      ],
      "showWhen": {
        "column": "many_units",
        "values": "si",
        "negate": true
      }
    },
    {
      "id": "s4_varias",
      "kind": "container",
      "ctype": "card",
      "label": "Qué unidades le pertenecen",
      "icon": "DoorOpen",
      "showWhen": {
        "column": "many_units",
        "values": "si"
      },
      "children": [
        {
          "id": "cal_varias",
          "kind": "component",
          "comp": "Callout",
          "props": {
            "tone": "neutral",
            "icon": "Info",
            "title": "Tiene varias unidades a su nombre",
            "text": "Se ven todas, con su participación, en su ficha. Para cambiar la parte de una unidad, entrá a esa unidad: es donde se ve si el 100 % está completo."
          }
        }
      ]
    },
    {
      "id": "s3",
      "kind": "container",
      "ctype": "card",
      "label": "Dónde cobra",
      "icon": "Landmark",
      "children": [
        {
