{
  "specVersion": 1,
  "kind": "form",
  "title": "Propietario",
  "blocks": [
    {
      "id": "s1",
      "kind": "container",
      "ctype": "card",
      "label": "Quién es",
      "icon": "User",
      "children": [
        {
          "id": "f_name",
          "kind": "field",
          "name": "name",
          "fieldType": "text",
          "label": "Nombre y apellido o razón social",
          "width": "half",
          "validations": [
            "required"
          ],
          "placeholder": "Ej: Ana María Ruiz"
        },
        {
          "id": "f_doc_type",
          "kind": "field",
          "name": "document_type",
          "fieldType": "enum",
          "label": "Documento",
          "width": "half",
          "validations": [
            "required"
          ],
          "options": [
            {
              "value": "cuit",
              "label": "CUIT"
            },
            {
              "value": "cuil",
              "label": "CUIL"
            },
            {
              "value": "dni",
              "label": "DNI"
            }
          ]
        },
        {
          "id": "f_doc",
          "kind": "field",
          "name": "document_number",
          "fieldType": "text",
          "label": "Número",
          "width": "half",
          "validations": [
            "required"
          ],
          "placeholder": "Ej: 27-11402887-3"
        },
        {
          "id": "f_tax",
          "kind": "field",
          "name": "tax_condition",
          "fieldType": "enum",
          "label": "Condición frente al IVA",
          "width": "half",
          "validations": [],
          "options": [
            {
              "value": "monotributo",
              "label": "Monotributo"
            },
            {
              "value": "responsable_inscripto",
              "label": "Responsable inscripto"
            },
            {
              "value": "exento",
              "label": "Exento"
            },
            {
              "value": "consumidor_final",
              "label": "Consumidor final"
            }
          ]
        }
      ]
    },
    {
