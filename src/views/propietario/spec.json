            }
          ]
        },
        {
          "id": "f_account",
          "kind": "field",
          "name": "account",
          "fieldType": "text",
          "label": "Tipo y número de cuenta",
          "width": "half",
          "validations": [],
          "placeholder": "Ej: Caja de ahorro 4001234-5"
        },
        {
          "id": "f_cbu",
          "kind": "field",
          "name": "cbu",
          "fieldType": "text",
          "label": "CBU",
          "width": "half",
          "validations": [],
          "placeholder": "22 dígitos"
        },
        {
          "id": "f_alias",
          "kind": "field",
          "name": "alias",
          "fieldType": "text",
          "label": "Alias",
          "width": "half",
          "validations": [],
