      "kind": "container",
      "ctype": "card",
      "label": "Contacto",
      "icon": "Phone",
      "children": [
        {
          "id": "f_email",
          "kind": "field",
          "name": "email",
          "fieldType": "text",
          "label": "Email",
          "width": "half",
          "validations": [],
          "placeholder": "Ej: ana.ruiz@gmail.com"
        },
        {
          "id": "f_phone",
          "kind": "field",
          "name": "phone",
          "fieldType": "text",
          "label": "Teléfono",
          "width": "half",
          "validations": [],
          "placeholder": "Ej: 341 555-1234"
        },
        {
          "id": "f_address",
          "kind": "field",
          "name": "address",
          "fieldType": "text",
          "label": "Domicilio",
          "validations": [],
          "placeholder": "Ej: Pellegrini 1450, Rosario"
        }
